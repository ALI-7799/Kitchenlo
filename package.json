{
  "name": "kitchenlo",
  "version": "2.0.0",
  "private": true,
  "description": "Kitchenlo — a statically generated recipe site with 30 tested recipes, meal planning and structured data for recipe search.",
  "homepage": "https://www.kitchenlo.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ALI-7799/Kitchenlo.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bundle": "node tools/bundle.mjs",
    "generate": "node .build/build.mjs",
    "pull": "node tools/bundle.mjs && node .build/pull.mjs",
    "migrate": "node tools/bundle.mjs && node .build/migrate.mjs",
    "migrate:check": "node tools/bundle.mjs && node .build/migrate.mjs --check",
    "build": "npm run typecheck && npm run bundle && npm run prepare:data && npm run bundle && npm run generate",
    "prepare:data": "node .build/pull.mjs --quiet",
    "dev": "node tools/bundle.mjs --watch",
    "test": "npm run build && node .build/smoke-test.mjs",
    "start": "npm run build && npx --yes serve ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": "22.x"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "postgres": "^3.4.9"
  }
}
