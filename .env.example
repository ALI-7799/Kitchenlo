# Kitchenlo backend configuration.
#
# Copy to .env for local work. .env is git-ignored and must stay that way —
# every value below is a secret that grants write access to the site.
#
# In production these are set in the Vercel dashboard under
# Settings -> Environment Variables, never in a file in the repository.
#
# Nothing here is ever sent to the browser. The public bundle reads no
# environment variables at all; only the serverless functions in api/ and the
# build-time tools in tools/ do.

# ---------------------------------------------------------------- database --

# Supabase -> Project Settings -> Database -> Connection string -> URI.
#
# Use the CONNECTION POOLER string (port 6543), not the direct one (5432).
# Serverless functions scale to many short-lived instances and will exhaust the
# direct connection limit under very little real traffic.
#
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ----------------------------------------------------------------- storage --

# Supabase -> Project Settings -> API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The SERVICE ROLE key, not the anon key. It bypasses row level security, so it
# must never appear in frontend code, a generated page, or a committed file.
# If it leaks, rotate it in the Supabase dashboard immediately.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for uploaded recipe images. Create it in Supabase under
# Storage -> New bucket, and mark it PUBLIC so the images can be served to
# visitors. Defaults to recipe-images when unset.
SUPABASE_BUCKET=recipe-images

# -------------------------------------------------------------------- auth --

# Signing salt for admin sessions and for the hashed IPs used in rate limiting.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates every active admin session, which is the fastest way
# to lock everyone out if you suspect a compromise.
ADMIN_SESSION_SECRET=

# ----------------------------------------------------------------- publish --

# Vercel -> Settings -> Git -> Deploy Hooks -> Create Hook (branch: main).
#
# The Publish button POSTs here to rebuild the static site from the database.
# Anyone holding this URL can trigger unlimited builds, so treat it as a secret.
# Leave it empty and the admin still works; publishing simply reports that it
# is not configured.
VERCEL_DEPLOY_HOOK_URL=
